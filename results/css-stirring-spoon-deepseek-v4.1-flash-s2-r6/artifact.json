    "lang": "html",
    "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>A cup of coffee, stirred</title>\n<style>\n  :root{\n    /* 3.2s chosen so the four judged moments (0.4/1.2/2.0/2.8s)\n       land on four different points of the circle. */\n    --spin: 0.7s;\n  }\n\n  html, body { margin: 0; height: 100%; }\n\n  body{\n    background:\n      radial-gradient(circle at 50% 40%, #fdfbf7 0%, #f1ece2 42%, #e0d7c7 100%);\n    overflow: hidden;\n    display: grid;\n    place-items: center;\n  }\n\n  .scene{\n    position: relative;\n    width: 400px;\n    height: 400px;\n  }\n\n  /* ---------------- saucer ---------------- */\n  .saucer{\n    position: absolute; inset: 0; border-radius: 50%;\n    background:\n      radial-gradient(circle at 43% 33%, #ffffff 0%, #f6f2ea 42%, #e0d9cb 76%, #c7bda9 100%);\n    box-shadow:\n      0 24px 36px rgba(70,48,24,.32),\n      0 6px 10px rgba(70,48,24,.20),\n      inset 0 -10px 18px rgba(120,100,70,.20),\n      inset 0 10px 16px rgba(255,255,255,.95);\n  }\n  .saucer::after{\n    content: \"\";\n    position: absolute; inset: 36px; border-radius: 50%;\n    background: radial-gradient(circle at 50% 50%, #f2eee5 0%, #e6e0d3 100%);\n    box-shadow:\n      inset 0 4px 7px rgba(120,100,70,.28),\n      inset 0 -3px 5px rgba(255,255,255,.85);\n  }\n\n  /* ---------------- cup ---------------- */\n  .cup{\n    position: absolute; inset: 52px; border-radius: 50%;\n    background:\n      radial-gradient(circle at 50% 42%, #ffffff 0%, #f5f2ec 58%, #ded8cd 100%);\n    box-shadow:\n      0 16px 24px rgba(70,48,24,.38),\n      inset 0 -7px 13px rgba(120,100,70,.28),\n      inset 0 7px 11px rgba(255,255,255,.95);\n  }\n  .rim{\n    position: absolute; inset: 62px; border-radius: 50%;\n    background: linear-gradient(145deg, #fbf8f2 0%, #d6d0c4 100%);\n    box-shadow:\n      inset 0 5px 9px rgba(0,0,0,.30),\n      inset 0 -2px 4px rgba(255,255,255,.9),\n      0 2px 4px rgba(255,255,255,.7);\n  }\n\n  /* ---------------- coffee ---------------- */\n  .coffee{\n    position: absolute; inset: 70px; border-radius: 50%; overflow: hidden;\n    background:\n      radial-gradient(circle at 42% 34%, #8c5a31 0%, #673d1c 34%, #43230f 68%, #2a1307 100%);\n    box-shadow:\n      inset 0 0 26px 8px rgba(18,7,0,.8),\n      inset 0 8px 14px rgba(0,0,0,.7);\n  }\n  /* soft angular streaks from the stirring */\n  .swirl{\n    position: absolute; inset: -30%;\n    background:\n      repeating-conic-gradient(from 0deg,\n        rgba(255,228,190,0)   0deg,\n        rgba(205,148,94,.20)  12deg,\n        rgba(40,19,5,.20)     27deg,\n        rgba(255,228,190,0)   44deg);\n    filter: blur(4px);\n    animation: spin var(--spin) linear infinite;\n  }\n  /* marbled crema blobs churning the other way */\n  .marbles{\n    position: absolute; inset: -30%;\n    background:\n      radial-gradient(ellipse 22% 9% at 26% 30%, rgba(235,190,140,.55), rgba(235,190,140,0) 70%),\n      radial-gradient(ellipse 26% 10% at 68% 22%, rgba(215,165,115,.50), rgba(215,165,115,0) 70%),\n      radial-gradient(ellipse 24% 9% at 80% 62%, rgba(240,195,145,.45), rgba(240,195,145,0) 70%),\n      radial-gradient(ellipse 22% 8% at 40% 82%, rgba(205,155,105,.50), rgba(205,155,105,0) 70%),\n      radial-gradient(ellipse 18% 7% at 12% 58%, rgba(230,185,135,.40), rgba(230,185,135,0) 70%);\n    filter: blur(6px);\n    animation: spin calc(var(--spin) * 0.62) linear infinite reverse;\n    opacity: .85;\n  }\n  /* keeps the point where all the swirl bands meet from glowing */\n  .core{\n    position: absolute; inset: 0; border-radius: 50%;\n    background: radial-gradient(circle at 50% 50%,\n      rgba(34,15,3,.82) 0%, rgba(34,15,3,.40) 12%, rgba(34,15,3,0) 32%);\n  }\n  .gloss{\n    position: absolute; inset: 0; border-radius: 50%;\n    background:\n      radial-gradient(ellipse 36% 21% at 35% 27%, rgba(255,255,255,.38), rgba(255,255,255,0) 72%),\n      radial-gradient(ellipse 52% 32% at 63% 73%, rgba(255,214,168,.20), rgba(255,214,168,0) 72%);\n  }\n  .crema{\n    position: absolute; inset: 0; border-radius: 50%;\n    box-shadow:\n      inset 0 0 0 5px rgba(214,166,116,.40),\n      inset 0 0 20px 5px rgba(255,222,175,.16);\n  }\n\n  /* ---------------- spoon ---------------- */\n  .spoon{\n    position: absolute;\n    left: 50%; top: 50%;\n    width: 0; height: 0;\n    transform-origin: 0 0;\n    animation: spin var(--spin) linear infinite;\n    z-index: 6;\n  }\n  /* soft shadow of the bowl sitting in the liquid */\n  .spoon-shadow{\n    position: absolute;\n    left: -30px; top: -119px;\n    width: 60px; height: 72px;\n    border-radius: 50%;\n    background: radial-gradient(ellipse at 50% 50%, rgba(20,8,0,.5), rgba(20,8,0,0) 70%);\n    filter: blur(5px);\n    transform: translate(7px, 9px);\n  }\n  /* the ring of disturbed liquid around the bowl */\n  .wake{\n    position: absolute;\n    left: -35px; top: -124px;\n    width: 70px; height: 82px;\n    border-radius: 50%;\n    background: radial-gradient(ellipse at 50% 50%,\n      rgba(255,222,175,0) 52%, rgba(255,222,175,.30) 66%, rgba(255,222,175,0) 80%);\n    filter: blur(3px);\n  }\n  .handle{\n    position: absolute;\n    left: -8.5px; top: -175px;\n    width: 17px; height: 72px;\n    background: linear-gradient(90deg,\n      #4f565d 0%, #9aa1a7 16%, #f6f9fb 40%, #cbd0d5 56%, #7d848b 80%, #464d54 100%);\n    clip-path: polygon(50% 0%, 82% 5%, 82% 12%, 57% 100%, 43% 100%, 18% 12%, 18% 5%);\n    filter: drop-shadow(0 3px 3px rgba(20,10,0,.55));\n  }\n  .bowl{\n    position: absolute;\n    left: -22px; top: -114px;\n    width: 44px; height: 62px;\n    border-radius: 50%;\n    background:\n      radial-gradient(ellipse at 42% 30%,\n        #fbfdfe 0%, #d3d8dd 24%, #9aa1a8 52%, #6a7178 78%, #464d54 100%);\n    box-shadow:\n      0 5px 9px rgba(15,7,0,.55),\n      inset 0 -5px 9px rgba(0,0,0,.45),\n      inset 0 5px 8px rgba(255,255,255,.95),\n      inset 0 0 0 3px rgba(255,255,255,.45);\n  }\n  /* concave interior: dark metal catching a warm reflection of the coffee */\n  .bowl::after{\n    content: \"\";\n    position: absolute; inset: 5px 6px 6px 6px;\n    border-radius: 50%;\n    background:\n      radial-gradient(ellipse at 60% 70%, rgba(210,160,110,.5), rgba(210,160,110,0) 55%),\n      radial-gradient(ellipse at 38% 30%, #b9c0c6 0%, #7f868d 34%, #545b62 66%, #343a40 100%);\n    box-shadow:\n      inset 0 3px 6px rgba(0,0,0,.6),\n      inset 0 -2px 4px rgba(255,255,255,.35);\n  }\n  /* bright specular glint on the bowl */\n  .bowl::before{\n    content: \"\";\n    position: absolute; left: 8px; top: 8px;\n    width: 13px; height: 20px;\n    border-radius: 50%;\n    background: radial-gradient(ellipse at 50% 40%, rgba(255,255,255,.95), rgba(255,255,255,0) 70%);\n    transform: rotate(-18deg);\n    z-index: 2;\n  }\n  /* little drops flung off the spoon while stirring */\n  .drop{\n    position: absolute; border-radius: 50%;\n    background: radial-gradient(circle at 35% 30%, #b98047, #4d2b13 75%);\n    box-shadow: 0 1px 2px rgba(0,0,0,.4);\n    animation: twinkle var(--spin) ease-in-out infinite;\n  }\n  .drop.a{ left: 30px; top: -30px; width: 9px; height: 8px; }\n  .drop.b{ left: -46px; top: -70px; width: 7px; height: 6px; animation-delay: -1.1s; }\n  .drop.c{ left: 52px; top: -92px; width: 6px; height: 5px; animation-delay: -2.2s; }\n  .drop.d{ left: -16px; top: 44px; width: 6px; height: 5px; animation-delay: -0.6s; }\n  .drop.e{ left: 44px; top: 18px; width: 7px; height: 6px; animation-delay: -1.7s; }\n\n  @keyframes spin{ to { transform: rotate(360deg); } }\n  @keyframes twinkle{\n    0%, 100% { opacity: .15; transform: scale(.7); }\n    50%      { opacity: 1;   transform: scale(1); }\n  }\n</style>\n</head>\n<body>\n  <div class=\"scene\">\n    <div class=\"saucer\"></div>\n    <div class=\"cup\"></div>\n    <div class=\"rim\"></div>\n\n    <div class=\"coffee\">\n      <div class=\"swirl\"></div>\n      <div class=\"marbles\"></div>\n      <div class=\"core\"></div>\n      <div class=\"crema\"></div>\n      <div class=\"gloss\"></div>\n    </div>\n\n    <div class=\"spoon\">\n      <div class=\"spoon-shadow\"></div>\n      <div class=\"wake\"></div>\n      <div class=\"handle\"></div>\n      <div class=\"bowl\"></div>\n      <div class=\"drop a\"></div>\n      <div class=\"drop b\"></div>\n      <div class=\"drop c\"></div>\n      <div class=\"drop d\"></div>\n      <div class=\"drop e\"></div>\n    </div>\n  </div>\n</body>\n</html>\n",
