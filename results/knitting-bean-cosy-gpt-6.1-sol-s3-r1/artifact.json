ext x=\"1044.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">10</text>\n<text x=\"1068.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">9</text>\n<text x=\"1092.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">8</text>\n<text x=\"1116.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">7</text>\n<text x=\"1140.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">6</text>\n<text x=\"1164.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">5</text>\n<text x=\"1188.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">4</text>\n<text x=\"1212.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">3</text>\n<text x=\"1236.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">2</text>\n<text x=\"1260.0\" y=\"753.4000000000001\" font-size=\"10\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"middle\" class=\"num\">1</text>\n<text x=\"1327\" y=\"523\" font-size=\"10\" fill=\"#607369\" font-weight=\"600\" transform=\"rotate(-90 1327 523)\" text-anchor=\"middle\" letter-spacing=\"1.5\">ROUND</text>\n<path d=\"M888 773v8h384v-8\" stroke=\"#ba754e\" stroke-width=\"1.5\" fill=\"none\"/>\n<text x=\"1080\" y=\"803\" font-size=\"13\" fill=\"#8c6853\" font-weight=\"500\" text-anchor=\"middle\">16 stitches · repeat 3 times</text>\n<path d=\"M420 782H128m0 0 9 -5m-9 5 9 5\" stroke=\"#284c40\" fill=\"none\" stroke-width=\"1.5\"/>\n<text x=\"440\" y=\"787\" font-size=\"14\" fill=\"#284c40\" font-weight=\"400\" >Start at lower right; read every round right → left.</text>\n<rect x=\"80\" y=\"837\" width=\"23\" height=\"17\" fill=\"#fffaf0\" stroke=\"#8c9989\" stroke-width=\"1\"/>\n<text x=\"115\" y=\"852\" font-size=\"15\" fill=\"#33473e\" font-weight=\"500\" >A / Oat · knit</text>\n<rect x=\"305\" y=\"837\" width=\"23\" height=\"17\" fill=\"#55352b\" stroke=\"#8c9989\" stroke-width=\"1\"/>\n<text x=\"340\" y=\"852\" font-size=\"15\" fill=\"#33473e\" font-weight=\"500\" >B / Espresso · knit</text>\n<path d=\"M578 845h28\" stroke=\"#ba754e\" stroke-width=\"2\" stroke-dasharray=\"5 4\"/>\n<text x=\"618\" y=\"852\" font-size=\"15\" fill=\"#33473e\" font-weight=\"400\" >Repeat boundary</text>\n<text x=\"1360\" y=\"852\" font-size=\"15\" fill=\"#596b60\" font-weight=\"400\" text-anchor=\"end\">1 cell = 1 stitch × 1 round</text>\n<path d=\"M80 883H1360\" stroke=\"#cbcfc1\"/>\n<text x=\"80\" y=\"924\" font-size=\"13\" fill=\"#284c40\" font-weight=\"700\" letter-spacing=\"1.4\">WHY THE CELLS ARE RECTANGULAR</text>\n<text x=\"80\" y=\"954\" font-size=\"18\" fill=\"#33473e\" font-weight=\"600\" >Gauge: 22 sts × 30 rnds = 10 × 10 cm</text>\n<text x=\"80\" y=\"983\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Measure washed stranded stockinette. Each cell is</text>\n<text x=\"80\" y=\"1008\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >1.36× wider than tall, just like a stitch at this gauge.</text>\n<text x=\"80\" y=\"1033\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >The ovals and curved clefts are shown at fabric scale,</text>\n<text x=\"80\" y=\"1058\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >not distorted by a square-cell chart. Swatch to match.</text>\n<text x=\"80\" y=\"1111\" font-size=\"11\" fill=\"#8c6853\" font-weight=\"700\" letter-spacing=\"1.5\">BODY SIZE</text>\n<text x=\"80\" y=\"1137\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >21.8 cm around × 8 cm high, before ribbing.</text>\n<text x=\"752\" y=\"924\" font-size=\"13\" fill=\"#284c40\" font-weight=\"700\" letter-spacing=\"1.4\">MAKE THE COSY</text>\n<text x=\"752\" y=\"954\" font-size=\"16\" fill=\"#ba754e\" font-weight=\"700\" >1</text>\n<text x=\"782\" y=\"954\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Cast on 48 sts in A; join without twisting.</text>\n<text x=\"782\" y=\"979\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Work 4 rounds of k1, p1 rib in A.</text>\n<text x=\"752\" y=\"1014\" font-size=\"16\" fill=\"#ba754e\" font-weight=\"700\" >2</text>\n<text x=\"782\" y=\"1014\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Knit chart rounds 1–24, using A and B as shown.</text>\n<text x=\"782\" y=\"1039\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Catch long floats every 3–4 sts; keep them loose.</text>\n<text x=\"752\" y=\"1074\" font-size=\"16\" fill=\"#ba754e\" font-weight=\"700\" >3</text>\n<text x=\"782\" y=\"1074\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Work 4 rounds of k1, p1 rib in A; bind off loosely.</text>\n<text x=\"782\" y=\"1099\" font-size=\"16\" fill=\"#33473e\" font-weight=\"400\" >Weave in ends and wet-block. Check fit on your cup.</text>\n<text x=\"1360\" y=\"1145\" font-size=\"10\" fill=\"#8c6853\" font-weight=\"600\" text-anchor=\"end\" letter-spacing=\"1.3\">CHART EXCLUDES THE RIBBED EDGES</text>\n</svg>",
