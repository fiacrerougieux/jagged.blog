    "lang": "html",
    "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>A cup of coffee, stirred</title>\n<style>\n  :root{ --coffee: 204px; }\n\n  html,body{height:100%;}\n  body{\n    margin:0;\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    overflow:hidden;\n    background:radial-gradient(circle at 50% 30%, #7d5836 0%, #4a3018 46%, #201106 100%);\n  }\n\n  .scene{\n    position:relative;\n    width:420px; height:400px;   /* cup centre: (210,190) */\n  }\n\n  /* ---------- saucer ---------- */\n  .saucer{\n    position:absolute; left:40px; top:20px;\n    width:340px; height:340px; border-radius:50%;\n    background:radial-gradient(circle at 41% 36%,\n      #ffffff 0%, #f3f3f6 42%, #d8d8df 68%, #bdbdc6 88%, #9fa0aa 100%);\n    box-shadow:\n      0 34px 55px rgba(0,0,0,.55),\n      0 8px 16px rgba(0,0,0,.35),\n      inset 0 0 0 2px rgba(255,255,255,.55);\n    z-index:1;\n  }\n  .saucer::after{\n    content:\"\"; position:absolute; left:50%; top:50%;\n    width:286px; height:286px; transform:translate(-50%,-50%);\n    border-radius:50%;\n    box-shadow:inset 0 0 0 2px rgba(0,0,0,.05), inset 0 8px 18px rgba(0,0,0,.12);\n  }\n\n  /* ---------- cup handle (a clean loop behind the cup) ---------- */\n  .cup-handle{\n    position:absolute; left:318px; top:190px;\n    width:120px; height:136px;\n    transform:translate(-50%,-50%);\n    box-sizing:border-box;\n    border:23px solid #e9e9ef;\n    border-radius:50%;\n    box-shadow:\n      0 14px 24px rgba(0,0,0,.45),\n      inset 0 0 0 2px rgba(255,255,255,.6),\n      0 0 0 2px rgba(0,0,0,.06);\n    z-index:2;\n  }\n\n  /* ---------- cup ---------- */\n  .cup{\n    position:absolute; left:85px; top:65px;\n    width:250px; height:250px; border-radius:50%;\n    background:radial-gradient(circle at 39% 32%,\n      #ffffff 0%, #f4f4f7 38%, #dcdce2 62%, #c2c2cb 82%, #a9a9b4 100%);\n    box-shadow:\n      0 22px 34px rgba(0,0,0,.45),\n      inset 0 0 0 3px rgba(255,255,255,.7),\n      inset 0 -12px 22px rgba(0,0,0,.14);\n    z-index:3;\n  }\n\n  /* inner wall of the cup, sloping down to the coffee */\n  .rim{\n    position:absolute; left:98px; top:78px;\n    width:224px; height:224px; border-radius:50%;\n    background:radial-gradient(circle at 44% 38%,\n      #f7f7f9 0%, #e9e9ee 55%, #cfcfd7 80%, #b6b6c0 100%);\n    box-shadow:\n      inset 0 0 0 2px rgba(255,255,255,.8),\n      inset 0 10px 20px rgba(0,0,0,.16),\n      inset 0 -6px 14px rgba(0,0,0,.08);\n    z-index:4;\n  }\n\n  /* ---------- coffee ---------- */\n  .coffee{\n    position:absolute; left:108px; top:88px;\n    width:var(--coffee); height:var(--coffee);\n    border-radius:50%; overflow:hidden;\n    background:radial-gradient(circle at 42% 36%,\n      #93613a 0%, #6f4626 28%, #4c2d16 60%, #2c1809 86%, #180c03 100%);\n    box-shadow:\n      inset 0 0 0 2px rgba(0,0,0,.4),\n      inset 0 0 0 9px rgba(196,150,98,.13),\n      inset 0 10px 28px rgba(0,0,0,.6),\n      inset 0 -6px 16px rgba(255,255,255,.05);\n    z-index:5;\n  }\n\n  /* crema / swirling surface */\n  .crema{\n    position:absolute; inset:0; border-radius:50%;\n    background:repeating-conic-gradient(from 0deg,\n      rgba(255,228,184,.07) 0deg 9deg,\n      rgba(110,66,30,.07) 9deg 20deg,\n      rgba(255,255,255,.02) 20deg 30deg);\n    mix-blend-mode:screen;\n    opacity:.55;\n    animation:swirl 1.1s linear infinite;\n  }\n  .crema::after{\n    content:\"\"; position:absolute; inset:30px; border-radius:50%;\n    background:radial-gradient(circle,\n      rgba(255,255,255,.08), rgba(255,255,255,0) 72%);\n  }\n\n  /* glossy highlight on the liquid */\n  .gloss{\n    position:absolute; left:26px; top:18px;\n    width:92px; height:56px; border-radius:50%;\n    transform:rotate(-28deg);\n    background:radial-gradient(ellipse at 50% 50%,\n      rgba(255,242,218,.45), rgba(255,242,218,0) 70%);\n    filter:blur(1px);\n  }\n\n  /* ---------- the spoon ---------- */\n  .spoon{\n    position:absolute; left:108px; top:88px;\n    width:var(--coffee); height:var(--coffee);\n    transform-origin:50% 50%;\n    animation:stir 0.5s linear infinite;\n    filter:drop-shadow(3px 5px 3px rgba(0,0,0,.5));\n    z-index:6;\n  }\n\n  /* handle runs from the bowl out to the rim */\n  .spoon .handle{\n    position:absolute;\n    left:calc(50% - 5px);\n    top:-18px;\n    width:10px;\n    height:124px;\n    border-radius:5px;\n    background:linear-gradient(90deg,\n      #6d6e76 0%, #b7b8c0 16%, #fcfcfe 44%, #d6d7dd 60%, #8c8d96 82%, #5c5d65 100%);\n    box-shadow:inset 0 0 0 1px rgba(255,255,255,.4);\n  }\n\n  /* shallow spoon bowl */\n  .spoon .bowl{\n    position:absolute;\n    left:calc(50% - 21px);\n    top:58px;\n    width:42px;\n    height:60px;\n    border-radius:50%;\n    background:radial-gradient(ellipse at 36% 28%,\n      #ffffff 0%, #ececf1 20%, #c3c4cd 46%, #8f909a 70%, #63646d 100%);\n    box-shadow:\n      inset 0 3px 5px rgba(255,255,255,.85),\n      inset 0 -9px 14px rgba(0,0,0,.5);\n  }\n  .spoon .bowl::after{\n    content:\"\"; position:absolute; left:7px; top:9px;\n    width:28px; height:40px; border-radius:50%;\n    background:radial-gradient(ellipse at 42% 34%,\n      #74757f 0%, #a3a4ad 38%, #d6d6dc 74%, #f4f4f7 100%);\n    box-shadow:inset 0 4px 7px rgba(0,0,0,.5);\n  }\n\n  /* ---------- a few bubbles ---------- */\n  .bubble{\n    position:absolute; border-radius:50%;\n    background:radial-gradient(circle at 35% 30%,\n      rgba(255,255,255,.6), rgba(255,255,255,.04) 70%);\n    z-index:7;\n  }\n  .b1{left:150px; top:120px; width:9px; height:9px; animation:drift 0.8s ease-in-out infinite;}\n  .b2{left:124px; top:152px; width:6px; height:6px; animation:drift 0.8s ease-in-out infinite .2s;}\n  .b3{left:132px; top:196px; width:7px; height:7px; animation:drift 0.8s ease-in-out infinite .4s;}\n\n  @keyframes stir{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }\n  @keyframes swirl{ from{transform:rotate(0deg);} to{transform:rotate(360deg);} }\n  @keyframes drift{\n    0%,100%{transform:translate(0,0) scale(1); opacity:.75;}\n    50%    {transform:translate(4px,-5px) scale(1.25); opacity:1;}\n  }\n</style>\n</head>\n<body>\n  <div class=\"scene\">\n    <div class=\"saucer\"></div>\n    <div class=\"cup-handle\"></div>\n    <div class=\"cup\"></div>\n    <div class=\"rim\"></div>\n    <div class=\"coffee\">\n      <div class=\"crema\"></div>\n      <div class=\"gloss\"></div>\n    </div>\n    <div class=\"spoon\">\n      <div class=\"handle\"></div>\n      <div class=\"bowl\"></div>\n    </div>\n    <div class=\"bubble b1\"></div>\n    <div class=\"bubble b2\"></div>\n    <div class=\"bubble b3\"></div>\n  </div>\n</body>\n</html>\n",
